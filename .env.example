# ── Front-end (Vite) ─────────────────────────────────────────────────
# Chaves PÚBLICAS: ficam no bundle do navegador. A segurança vem das
# políticas RLS do Postgres, não do sigilo destas chaves.
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key-publica>

# ── Edge Functions (Supabase → Project Settings → Edge Functions → Secrets) ──
# NÃO coloque estes valores em arquivo versionado. Estão aqui só como lista
# do que as funções esperam encontrar.
#
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # nunca no front-end
# LOVABLE_API_KEY=             # geração de e-mail por IA
# RESEND_API_KEY=              # envio de e-mails
# RESEND_FROM_EMAIL=
# ASAAS_API_KEY=               # cobrança dos produtos pagos
# ASAAS_WEBHOOK_TOKEN=         # valida o webhook de pagamento
# ASAAS_ENV=sandbox            # sandbox | production
